{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "BananaSplit Docs",
  "colors": {
    "primary": "#7b260f",
    "light": "#ffe66f",
    "dark": "#7b260f"
  },
  "favicon": {
    "light": "/images/favicon-16x16.png",
    "dark": "/images/favicon-16x16.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "CLI",
        "pages": [
          "cli/overview",
          "cli/installation",
          "cli/authentication",
          "cli/commands",
          "cli/output-formats"
        ]
      },
      {
        "group": "Agent integration",
        "pages": [
          "agents/overview",
          "agents/skill-installation",
          "agents/supported-agents",
          "agents/example-prompts"
        ]
      },
      {
        "group": "QR Code API",
        "pages": [
          "qr-code/overview",
          "qr-code/endpoints",
          "qr-code/examples"
        ]
      },
      {
        "group": "MCP",
        "pages": [
          "mcp/overview",
          "mcp/setup",
          "mcp/tools"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "CLI",
          "href": "/cli/overview",
          "icon": "terminal"
        },
        {
          "anchor": "Agents",
          "href": "/agents/overview",
          "icon": "robot"
        },
        {
          "anchor": "MCP",
          "href": "/mcp/overview",
          "icon": "plug"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/banana-icon.png",
    "dark": "/images/banana-icon.png",
    "href": "https://bananasplit.net/"
  },
  "navbar": {
    "links": [
      {
        "label": "App",
        "href": "https://bananasplit.net"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get the app",
      "href": "https://bananasplit.net"
    }
  },
  "footer": {
    "socials": {
      "website": "https://bananasplit.net",
      "github": "https://github.com/teotti/banana-cli"
    }
  },
  "seo": {
    "indexHiddenPages": false
  },
  "description": "BananaSplit is the expense tracking layer for AI agents and developers. Add expenses, record payments, and check balances through the CLI, MCP server, or agent skills — your data syncs across iOS, Android, and web."
}
