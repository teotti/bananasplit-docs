{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "quill",
  "name": "BananaSplit Docs",
  "colors": {
    "primary": "#7b260f",
    "light": "#ffe66f",
    "dark": "#7b260f",
    "background": {
      "light": "#fafafa",
      "dark": "#1a1a1a"
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "CLI",
        "pages": [
          "cli/overview",
          "cli/installation",
          "cli/authentication",
          "cli/commands",
          "cli/output-formats"
        ]
      },
      {
        "group": "Agent integration",
        "pages": [
          "agents/overview",
          "agents/skill-installation",
          "agents/supported-agents",
          "agents/example-prompts"
        ]
      },
      {
        "group": "QR Code API",
        "pages": [
          "qr-code/overview",
          "qr-code/endpoints",
          "qr-code/examples"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "CLI",
          "href": "/cli/overview",
          "icon": "terminal"
        },
        {
          "anchor": "Agents",
          "href": "/agents/overview",
          "icon": "robot"
        },
        {
          "anchor": "QR Code API",
          "href": "/qr-code/overview",
          "icon": "qrcode"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "App",
        "href": "https://bananasplit.net"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get the app",
      "href": "https://bananasplit.net"
    }
  },
  "footer": {
    "socials": {
      "website": "https://bananasplit.net",
      "github": "https://github.com/teotti/banana-cli"
    }
  },
  "seo": {
    "indexHiddenPages": false
  },
  "integrations": {
    "llmsTxt": true
  }
}
